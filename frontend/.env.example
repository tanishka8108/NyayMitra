# =========================================================
# NyayMitra Frontend — Environment
#
# Vite only reads .env files from the FRONTEND root, not
# from the repository root. These values are inlined into
# the bundle at build time (they must start with VITE_).
#
# Copy this file to `.env` and adjust if needed:
#     cp .env.example .env
# =========================================================

# Lawyer FastAPI service (profile, listing, practice areas)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Model API (src/api.py): /understand-situation + /predict-delay
# Deliberately separate from VITE_API_BASE_URL above - that one is the
# lawyer service, this one is the model service, and they are not the
# same process. Both default to port 8000, so do not run them at the
# same time unless one of them is moved (see the README port note).
VITE_MODEL_API_URL=http://127.0.0.1:8000

# NLP / translation FastAPI service (translate, voice)
VITE_TRANSLATION_API_URL=http://127.0.0.1:8001

# Bearer key expected by the translation service
# (matches API_KEY in translate_service.py)
VITE_TRANSLATION_API_KEY=your_api_key_here

# Lawyer whose profile opens during development.
# After login this is overridden by the signed-in session.
VITE_LAWYER_ID=LAWYER_0003

# Auth mode: "api" (FastAPI /api/auth/register|login — the default)
# or "mock" (offline demo accounts). Demo credentials exist only in
# development builds: production bundles never contain them.
VITE_AUTH_MODE=api

# Case document retrieval (GET /api/cases/{cnr}/documents) — not
# mounted in the backend yet. When the endpoint exists the Case
# detail screen uses it as-is; set this to "true" to show clearly
# labelled DEMO rows instead, for UI work only. Ignored (and never
# bundled) in production builds.
# VITE_CASE_DOCUMENTS_MOCK=true

# Chat mode: "api" (FastAPI /api/chat — the default: conversations
# and messages persist server-side in SQLite) or "mock" (threads
# kept in localStorage, works offline for demos).
VITE_CHAT_MODE=api

# Authority mode: reserved for when FastAPI exposes /authorities.
# NOT READ YET — grants are always kept in localStorage until then,
# so changing this value has no effect on current behaviour.
VITE_AUTHORITY_MODE=mock
